{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alawein/eval-audit/schema/result-record.v1.json",
  "title": "Eval Audit result record",
  "type": "object", "additionalProperties": false,
  "required": ["id", "status", "score", "reason"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "trial": {"type": "integer", "minimum": 1, "maximum": 10000},
    "status": {"enum": ["scored", "errored", "unscored"]},
    "score": {"type": ["number", "null"]},
    "reason": {"type": "string", "maxLength": 4000}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "scored"}}},
     "then": {"properties": {"score": {"type": "number"}}}},
    {"if": {"properties": {"status": {"const": "unscored"}}},
     "then": {"properties": {"score": {"type": "null"}}}}
  ]
}
