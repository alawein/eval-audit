{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alawein/eval-audit/schema/report.v1.json",
  "title": "Eval Audit report, compatible schema 1 and 2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "counts", "score_present_coverage",
    "missing_ids", "unexpected_ids", "errored_with_score_ids", "exit_code"],
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "pairs": {"type": "array", "uniqueItems": true, "items": {"type": "object",
      "additionalProperties": false, "required": ["id", "trial"], "properties": {
        "id": {"type": "string"}, "trial": {"type": "integer", "minimum": 1, "maximum": 10000}}}},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2]},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "counts": {"type": "object", "additionalProperties": false,
      "required": ["expected", "scored", "errored", "unscored", "missing", "score_present"],
      "properties": {
        "expected": {"$ref": "#/$defs/count"}, "scored": {"$ref": "#/$defs/count"},
        "errored": {"$ref": "#/$defs/count"}, "unscored": {"$ref": "#/$defs/count"},
        "missing": {"$ref": "#/$defs/count"}, "score_present": {"$ref": "#/$defs/count"}}},
    "score_present_coverage": {"$ref": "#/$defs/coverage"},
    "missing_ids": {"$ref": "#/$defs/ids"}, "unexpected_ids": {"$ref": "#/$defs/ids"},
    "errored_with_score_ids": {"$ref": "#/$defs/ids"},
    "exit_code": {"type": "integer", "enum": [0, 1]},
    "inputs": {"type": "object", "additionalProperties": false,
      "required": ["manifest_sha256", "records_sha256"], "properties": {
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "records_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "trial_counts": {"type": "object", "additionalProperties": false,
      "required": ["expected", "delivered", "scored", "errored", "unscored", "missing", "score_present", "unexpected", "duplicate"],
      "properties": {
        "expected": {"$ref": "#/$defs/count"}, "delivered": {"$ref": "#/$defs/count"},
        "scored": {"$ref": "#/$defs/count"}, "errored": {"$ref": "#/$defs/count"},
        "unscored": {"$ref": "#/$defs/count"}, "missing": {"$ref": "#/$defs/count"},
        "score_present": {"$ref": "#/$defs/count"}, "unexpected": {"$ref": "#/$defs/count"}, "duplicate": {"const": 0}}},
    "trial_score_present_coverage": {"$ref": "#/$defs/coverage"},
    "complete_ids": {"$ref": "#/$defs/ids"},
    "missing_trials": {"$ref": "#/$defs/pairs"}, "unexpected_trials": {"$ref": "#/$defs/pairs"},
    "errored_with_score_trials": {"$ref": "#/$defs/pairs"},
    "pass_k_denominators": {"type": "object", "propertyNames": {"pattern": "^[1-9][0-9]*$"},
      "additionalProperties": {"type": "object", "additionalProperties": false,
        "required": ["expected_ids", "all_k_trials_scored"], "properties": {
          "expected_ids": {"$ref": "#/$defs/count"}, "all_k_trials_scored": {"$ref": "#/$defs/count"}}}}
  },
  "allOf": [{"if": {"properties": {"schema_version": {"const": 2}}},
    "then": {"required": ["trial_counts", "trial_score_present_coverage", "complete_ids",
      "missing_trials", "unexpected_trials", "errored_with_score_trials", "pass_k_denominators"]},
    "else": {"not": {"anyOf": [{"required": ["trial_counts"]}, {"required": ["complete_ids"]},
      {"required": ["trial_score_present_coverage"]}, {"required": ["missing_trials"]},
      {"required": ["unexpected_trials"]}, {"required": ["errored_with_score_trials"]},
      {"required": ["pass_k_denominators"]}]}}}]
}
